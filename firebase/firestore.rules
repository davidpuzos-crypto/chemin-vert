rules_version = '2';

/* ============================================================================
   Chemin Vert — règles de sécurité Firestore
   ----------------------------------------------------------------------------
   PRINCIPE : plus aucune écriture n'est possible depuis un navigateur.

   La clé Firebase du site est publique par conception : elle est lisible dans
   config.js, donc par n'importe qui. Tant que le navigateur écrivait
   directement en base, aucune règle ne pouvait distinguer un visiteur d'un
   script — et App Check, la seule parade possible, s'est révélé inaccessible
   sans activer la facturation Google.

   Les écritures passent donc par deux fonctions serverless, netlify/functions/
   sign.mjs et unsubscribe.mjs, qui s'authentifient avec une clé de service.
   Le SDK Admin ignore ces règles : elles ne gênent pas les fonctions, elles
   ferment la porte à tout le reste.

   Ce que cela protège, et que les règles seules ne pouvaient pas protéger :
     - le compteur public ne peut plus être gonflé ni remis à zéro ;
     - personne ne peut créer de fausses signatures en masse ;
     - une signature ne peut plus être supprimée directement depuis le web ;
     - le compteur et la collection ne peuvent plus diverger, les fonctions
       les modifiant dans une seule et même transaction.

   SEULE OUVERTURE : la lecture du compteur, qui doit rester publique pour que
   le chiffre s'affiche sur le site. Un document, un entier, aucune donnée
   personnelle.

   ATTENTION : la validation du format des adresses ne vit plus ici, puisque
   les écritures clientes sont refusées avant d'être examinées. Elle est dans
   netlify/lib/guard.mjs. Une règle de validation ajoutée ci-dessous n'aurait
   aucun effet, le SDK Admin ne les évalue pas.

   Tests : firebase/rules.test.mjs
   Marche à suivre : section « Compteur et signatures » de BOUTIQUE-SETUP.md
   ========================================================================= */

service cloud.firestore {
  match /databases/{database}/documents {

    // Compteur public : lecture libre, écriture réservée au serveur.
    match /stats/counter {
      allow read: if true;
      allow write: if false;
    }

    // Signatures : ni lues, ni listées, ni écrites depuis un navigateur.
    // Les adresses e-mail ne sortent jamais de la base.
    match /signatures/{email} {
      allow read, write: if false;
    }

    // Tout le reste est fermé. Firestore refuse déjà par défaut ce qui n'est
    // pas explicitement autorisé ; ce bloc rend l'intention lisible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
