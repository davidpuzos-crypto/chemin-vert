# ============================================================================
#  Variables d'environnement — MODÈLE
#  Ce fichier est un EXEMPLE versionné : il ne contient AUCUN secret réel.
#  Les vraies valeurs se saisissent dans Netlify :
#    Netlify → votre site → Site configuration → Environment variables
#  (et dans un fichier .env local, jamais commité, pour les tests)
# ============================================================================

# --- Printful ---------------------------------------------------------------
# Jeton privé créé sur https://developers.printful.com/tokens
# Niveau d'accès "Store", scopes : orders (lecture+écriture), sync_products/read
PRINTFUL_API_KEY=collez-ici-le-jeton-printful   # commence par smk_

# Créer la commande Printful en BROUILLON (false) ou l'envoyer directement
# en production (true → votre carte Printful est débitée automatiquement).
# Laissez "false" au lancement : vous confirmez à la main dans Printful.
PRINTFUL_AUTO_CONFIRM=false

# --- Stripe -----------------------------------------------------------------
# Clé secrète : sk_test_... pour les tests, sk_live_... en production
STRIPE_SECRET_KEY=collez-ici-la-cle-secrete-stripe   # commence par sk_test_ ou sk_live_
# Secret de signature du webhook (whsec_...), donné par Stripe à la création
# de l'endpoint. Il est DIFFÉRENT en test et en production.
STRIPE_WEBHOOK_SECRET=collez-ici-le-secret-du-webhook   # commence par whsec_

# --- Boutique ---------------------------------------------------------------
# Frais de port facturés au client, en centimes (450 = 4,50 €)
SHIPPING_FLAT_CENTS=450
# Pays de livraison autorisés (codes ISO, séparés par des virgules)
ALLOWED_COUNTRIES=FR
# URL publique finale du site (sans / final) — sert aux pages de retour Stripe
SITE_URL=https://chemin-vert.netlify.app
